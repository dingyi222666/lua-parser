{
  LinearLayout,
  orientation=1,
  layout_height="fill",
  layout_width="fill",
  gravity="center",
  layoutTransition=LayoutTransition().enableTransitionType(LayoutTransition.CHANGING),
  {
    RelativeLayout,
    layout_height="56dp",
    layout_width="fill",
    gravity="left|center",

    {
      LinearLayout,
      layout_height="56dp",
      layout_width="fill",
      id="navBar",
      gravity="left|center",
      backgroundColor=0xFFF4A7B9,
      {
        TextView,
        text="应用管理",
        textSize="18sp",
        layout_weight="1",
        textColor=0xffffffff,
        layout_marginLeft="16dp"
      },
      {
        ImageView,
        src="image/search.png",
        layout_height="56dp",
        layout_width="56dp",
        colorFilter=0xffffffff,
        padding="15.6dp",
        onClick=function(v)
          ViewAnimationUtils.createCircularReveal(searchBar,navBar.getChildAt(1).x+ViewUtil.dp2px(25),ViewUtil.dp2px(56/2),navBar.getChildAt(1).width-ViewUtil.dp2px(56),v.parent.width)
          .setInterpolator(DecelerateInterpolator())
          .setDuration(500)
          .addListener {
            onAnimationStart=function()
              searchBar.visibility=0
            end
          }
          .start()
        end,
        backgroundDrawable=ViewUtil.ripple(ViewUtil.MODE.ROUND,0x3ffffffff),
      },
      {
        ImageView,
        src="image/more_vert.png",
        layout_height="56dp",
        layout_width="56dp",
        layout_marginLeft="12dp",
        colorFilter=0xffffffff,
        padding="15.6dp",
        onClick=function()end,
        backgroundDrawable=ViewUtil.ripple(ViewUtil.MODE.ROUND,0x3ffffffff),
      }
    },
    {
      LinearLayout,
      layout_height="56dp",
      layout_width="fill",
      id="searchBar",
      visibility=8,
      gravity="left|center",
      backgroundColor=0xffffffff,
      {
        ImageView,
        src="image/arrow_back.png",
        layout_height="56dp",
        layout_width="56dp",
        padding="15.6dp",
        onClick=function(v)
          ViewAnimationUtils.createCircularReveal(searchBar,navBar.getChildAt(1).x+ViewUtil.dp2px(24),ViewUtil.dp2px(56/2),v.parent.width+ViewUtil.dp2px(56),navBar.getChildAt(1).width-ViewUtil.dp2px(56))
          .setInterpolator(DecelerateInterpolator())
          .setDuration(500)
          .addListener {
            onAnimationEnd=function()
              searchBar.visibility=8
              if utf8.len(searchText.text)>0 or _search==true then
                refresh()                               
              end
              _search=false
              searchText.text=""
            end
          }
          .start()
        end,
        backgroundDrawable=ViewUtil.ripple(ViewUtil.MODE.ROUND),
      },
      {
        EditText,
        hint="搜索应用....",
        id="searchText",
        singleLine=true,
        backgroundColor=0,
        layout_marginLeft="2dp",
        layout_weight="1",
      },
      {
        ImageView,
        src="image/search.png",
        layout_height="56dp",
        layout_width="56dp",
        padding="15.6dp",
        onClick=function(v)
          _search=true
          if parent:getPageView().currentItem ==0 then
            search(v.parent.getChildAt(1).text.."",1)
           else
            search(v.parent.getChildAt(1).text.."",2)
          end
        end,
        backgroundDrawable=ViewUtil.ripple(ViewUtil.MODE.ROUND),
      }
    },
  },
  {
    MyTabLayout
    {
      id="parent",
      texts={"用户应用","系统应用","安装包管理"},
      pages={"layout/page_item","layout/page_item","layout/page_item"}
    },
  }

}

